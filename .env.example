# Copy to .env for local development. Never commit the real file.
#
# Two kinds of variable live here, and the difference matters:
#
#   EDUBOT_*  read by api/config.py through pydantic-settings, which loads
#             this file itself.
#   the rest  plain environment variables read by core/llm.py with
#             os.environ. pydantic-settings does NOT put them there, so a
#             key written here only reaches the tutor if the process was
#             started with `uv run --env-file .env ...`, or you exported it
#             in your shell. Setting UV_ENV_FILE=.env once does it for good.

EDUBOT_ENVIRONMENT=development

# Which provider the tutor phrases hints with. Leave unset and the cheapest
# configured key wins; see PROVIDERS in core/llm.py.
#   EDUBOT_PROVIDER=fireworks
#   EDUBOT_PROVIDER=anthropic

# Override the model for whichever provider is in force. Run
# `uv run python -m core.models` to list what your key can actually serve --
# Fireworks retires serverless models without much warning.
#   EDUBOT_MODEL=accounts/fireworks/models/...

# One of these is enough. Neither is required: with no key the tutor shows the
# coaching step instead of prose, which is the quickest way to read the
# machinery without spending anything.
FIREWORKS_API_KEY= 
ANTHROPIC_API_KEY=

# Phase 2 onward
EDUBOT_SUPABASE_URL=
EDUBOT_SUPABASE_SERVICE_KEY=
